# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth (for student Drive/Docs access)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Sentry (optional — leave blank to disable error reporting)
# Server DSN; falls back to NEXT_PUBLIC_SENTRY_DSN if unset.
SENTRY_DSN=
# Browser DSN — must be public-prefixed since it ships to the client bundle.
NEXT_PUBLIC_SENTRY_DSN=

# Admin (comma-separated emails; full match against the user's Google login)
# Anyone listed here can reach /admin and /api/admin. Leave blank to disable
# admin entirely (a 403 redirect for everyone).
ADMIN_EMAILS=

# Super-grader satellite integration
# -----------------------------------------------------------------------------
# Anonymization salt — base64-encoded 32+ random bytes, shared ecosystem-wide
# with super-grader and AI Documenter. Rotating invalidates every stored
# anon_token across all peers; treat rotation as a security incident response,
# not routine. Copy from AI Documenter's .env.local / Vercel project.
SUPER_GRADER_SALT=

# Bearer token super-grader presents on inbound GET /api/super-grader/* requests.
# Generate fresh (32+ random bytes, hex/base64) — distinct from the ingest
# tokens below. Leaving this blank → /api/super-grader/* returns 500 (loud).
HANDWRITTEN_API_TOKEN=

# Where to push the outbound webhook on every confirmed submission. When
# super-grader isn't deployed, leave blank — the push silently no-ops and
# the student flow is unaffected.
SUPER_GRADER_INGEST_URL=
# Bearer we present on the outbound POST to SUPER_GRADER_INGEST_URL/api/ingest/handwritten.
# Must match AI_DOCUMENTER_INGEST_TOKEN equivalent on super-grader's side
# (the var name there is HANDWRITTEN_INGEST_TOKEN).
SUPER_GRADER_INGEST_TOKEN=
