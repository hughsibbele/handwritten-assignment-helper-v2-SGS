# Handwritten Helper — env template
#
# This file is the CANONICAL source of truth for which env vars the app
# reads. If you add a new env var in code, add it here in the same PR. If
# you rename one on Vercel, rename it here too. See README.md → Secrets.
#
# Local dev: copy this file to .env.local and fill in values.
# Vercel:    set each var on the project's Settings → Environment Variables.


# ---- Supabase ---------------------------------------------------------------
# Pull from Supabase dashboard → Project Settings → API.
# Modern publishable key (`sb_publishable_*`).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ---- Gemini -----------------------------------------------------------------
# Single ecosystem-wide key. Same value also lives in AI Documenter and
# (eventually) Super Grader. EHS pays for the key centrally.
GEMINI_API_KEY=your-gemini-api-key

# Per-teacher daily Gemini call cap. Defaults to 1000 if unset. Per-teacher
# override via teachers.gemini_daily_cap column. Sized for one class × ~30
# students × ~10 pages = 300 calls, with ~3× headroom.
GEMINI_DEFAULT_DAILY_CAP=1000


# ---- Google OAuth (for student Drive/Docs access) ---------------------------
# Web OAuth client in https://console.cloud.google.com/apis/credentials.
# Authorized redirect URI: <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---- Inngest ----------------------------------------------------------------
# From inngest.com → Apps → "handwritten-helper" → Keys.
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key


# ---- Sentry (optional — leave blank to disable error reporting) -------------
# Server DSN; falls back to NEXT_PUBLIC_SENTRY_DSN if unset.
SENTRY_DSN=
# Browser DSN — must be public-prefixed since it ships to the client bundle.
NEXT_PUBLIC_SENTRY_DSN=


# ---- Admin (HAH-specific; allowlist gate for /admin and /api/admin) ---------
# Comma-separated emails. Full match against the user's Google login.
# Leave blank to disable admin entirely (a redirect for everyone).
# Future: graduate to AI Documenter's admins-table pattern when there's
# more than one admin surface (see project memory).
ADMIN_EMAILS=


# ---- Super Grader satellite integration =====================================
# HAH is a "satellite" of Super Grader. Three secrets here are SHARED with
# the Super Grader project — they must hold byte-identical values across
# projects, but each project NAMES them after who it's talking to. See
# README.md → Secrets for the cross-project mapping table.

# Anonymization salt — 32+ random bytes base64-encoded.
# SHARED VALUE across HAH ↔ AI Documenter ↔ Super Grader (all use this same
# var name). To set up locally: copy from AI Documenter's .env.local. To
# set up on Vercel: copy from AI Documenter's Vercel project.
# Rotating this invalidates every stored anon_token everywhere — treat as
# a security incident response, not a routine change.
SUPER_GRADER_SALT=

# Bearer Super Grader presents on inbound GET /api/super-grader/* requests.
# SHARED VALUE with Super Grader (where it's named HANDWRITTEN_API_TOKEN
# there too — same var name, same value). Generate fresh:
#   openssl rand -hex 32
# Leaving this blank → /api/super-grader/* returns 500 (loud, so misconfig
# surfaces during initial setup rather than masquerading as a bad token).
HANDWRITTEN_API_TOKEN=

# Base URL of the Super Grader deployment. Code appends /api/ingest/handwritten.
# When Super Grader isn't deployed, leave blank — the webhook silently no-ops
# and the student flow is unaffected.
SUPER_GRADER_API_URL=

# Bearer HAH presents on the outbound POST to <SUPER_GRADER_API_URL>/api/ingest/handwritten.
# SHARED VALUE with Super Grader, where it's named HANDWRITTEN_INGEST_TOKEN
# (asymmetric naming on purpose: HAH names it after who it's authing TO,
# Super Grader names it after who's authing IN).
SUPER_GRADER_INGEST_TOKEN=
